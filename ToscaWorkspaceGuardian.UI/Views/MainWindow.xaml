<Window x:Class="ToscaWorkspaceGuardian.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tosca Upgrade Guide" Width="1060" Height="720" MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="#F3F6F8" Foreground="#20384C" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Blue" Color="#005CA9"/>
        <SolidColorBrush x:Key="Navy" Color="#164A70"/>
        <SolidColorBrush x:Key="Ink" Color="#20384C"/>
        <SolidColorBrush x:Key="Muted" Color="#647A8C"/>
        <SolidColorBrush x:Key="Field" Color="#E8F0F5"/>
        <SolidColorBrush x:Key="Line" Color="#C9DCE9"/>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="14"/></Style>
        <Style x:Key="Step" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Navy}"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="{StaticResource Field}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9,6"/><Setter Property="MinHeight" Value="34"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Background" Value="{StaticResource Field}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="7,4"/><Setter Property="MinHeight" Value="34"/></Style>
        <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="{StaticResource Field}"/></Style>
        <Style TargetType="Button"><Setter Property="Background" Value="{StaticResource Blue}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Blue}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,7"/><Setter Property="MinHeight" Value="34"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"><TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontWeight="{TemplateBinding FontWeight}" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#0A6BB7"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="#004A84"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Background" Value="#DCE7EF"/><Setter TargetName="Root" Property="BorderBrush" Value="#B7CBD9"/><Setter Property="Foreground" Value="#58758C"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#E8F0F5"/><Setter Property="Foreground" Value="{StaticResource Navy}"/><Setter Property="BorderBrush" Value="#9FC3D9"/></Style>
    </Window.Resources>
    <Grid><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#005A9F" Padding="24,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="36" Height="36" Background="#0D70B9" BorderBrush="#8BC7E9" BorderThickness="1" CornerRadius="2"><TextBlock Text="TG" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="Tosca Upgrade Guide" Foreground="White" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="2025.1 → 2026.1 · READ-ONLY WORKSPACE ASSESSMENT" Foreground="#DCECF7" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel></StackPanel><TextBlock Grid.Column="1" Text="STATIC UPGRADE WORKSPACE" Foreground="#DCECF7" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid></Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="22" MaxWidth="1180">
            <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="1" Foreground="White" Background="{StaticResource Blue}" Width="25" Height="25" TextAlignment="Center" Padding="0,3,0,0" FontWeight="Bold"/><StackPanel Grid.Column="1" Margin="8,0,12,0"><TextBlock Text="SOURCE VERSION" Style="{StaticResource Label}"/><ComboBox SelectedValue="{Binding SourceVersion}" SelectedValuePath="Content"><ComboBoxItem Content="2025.1"/></ComboBox></StackPanel><StackPanel Grid.Column="2" Margin="0,0,0,0"><TextBlock Text="DESTINATION VERSION" Style="{StaticResource Label}"/><ComboBox SelectedValue="{Binding TargetVersion}" SelectedValuePath="Content"><ComboBoxItem Content="2026.1"/></ComboBox></StackPanel></Grid></Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="2" Foreground="White" Background="{StaticResource Blue}" Width="25" Height="25" TextAlignment="Center" Padding="0,3,0,0" FontWeight="Bold"/><StackPanel Grid.Column="1" Margin="8,0,12,0"><TextBlock Text="TOSCA WORKSPACE (.TWS)" Style="{StaticResource Label}"/><TextBox Text="{Binding WorkspacePath}" IsReadOnly="True" ToolTip="Selected workspace path"/><TextBlock Text="{Binding WorkspaceAccessStatus}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="2"><Button Content="Select .tws" Command="{Binding BrowseWorkspaceCommand}"/><Border Background="#F1F7FB" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="7" Margin="0,7,0,0"><TextBlock Text="{Binding RepositoryType}" Foreground="{StaticResource Navy}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/></Border></StackPanel></Grid></Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Visibility="{Binding ShowSqlAuthentication, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="3" Foreground="White" Background="{StaticResource Blue}" Width="25" Height="25" TextAlignment="Center" Padding="0,3,0,0" FontWeight="Bold"/><StackPanel Grid.Column="1" Margin="8,0,8,0"><TextBlock Text="MSSQL USERNAME" Style="{StaticResource Label}"/><TextBox Text="{Binding Username}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="MSSQL PASSWORD" Style="{StaticResource Label}"/><PasswordBox PasswordChanged="PasswordBox_OnPasswordChanged" Background="{StaticResource Field}" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="9,6" MinHeight="34"/><TextBlock Text="Used only to open this workspace; never saved to JSON." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel></Grid></Border>
            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Visibility="{Binding ShowTsrAuthentication, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="3" Foreground="White" Background="{StaticResource Blue}" Width="25" Height="25" TextAlignment="Center" Padding="0,3,0,0" FontWeight="Bold"/><StackPanel Grid.Column="1" Margin="8,0,8,0"><TextBlock Text="TOSCA SERVER CLIENT ID" Style="{StaticResource Label}"/><TextBox Text="{Binding ClientId}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="TOSCA SERVER CLIENT SECRET" Style="{StaticResource Label}"/><PasswordBox PasswordChanged="ClientSecretBox_OnPasswordChanged" Background="{StaticResource Field}" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="9,6" MinHeight="34"/></StackPanel></Grid></Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Background="#F1F8FC" BorderBrush="#B8D8EA"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/><ColumnDefinition Width="112"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions><TextBlock Text="4" Foreground="White" Background="{StaticResource Blue}" Width="25" Height="25" TextAlignment="Center" Padding="0,3,0,0" FontWeight="Bold"/><StackPanel Grid.Column="1" Margin="8,0,12,0"><TextBlock Text="WORKSPACE ANALYSIS" Style="{StaticResource Step}"/><TextBlock Text="{Binding TcShellStatus}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding WorkspaceInventoryStatus}" Foreground="{StaticResource Blue}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="2" Content="Verify license" Command="{Binding CheckTCShellCommand}" Margin="0,0,7,0" VerticalAlignment="Center"/><Button Grid.Column="3" Content="Analyze scan" Command="{Binding AnalyzeWorkspaceInventoryCommand}" Margin="0,0,7,0" VerticalAlignment="Center"/><StackPanel Grid.Column="4" VerticalAlignment="Center"><Button Style="{StaticResource Secondary}" Content="Cancel scan" Command="{Binding CancelWorkspaceInventoryCommand}"/><Button Style="{StaticResource Secondary}" Content="Activity monitor" Click="OpenActivityMonitor_OnClick" Margin="0,6,0,0"/></StackPanel></Grid></Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><TextBlock Text="5" Foreground="White" Background="{StaticResource Blue}" Width="25" Height="25" TextAlignment="Center" Padding="0,3,0,0" FontWeight="Bold"/><StackPanel Grid.Column="1" Margin="8,0,12,0"><TextBlock Text="UPGRADE REPORT" Style="{StaticResource Step}"/><TextBlock Text="{Binding InventoryUpgradeScanStatus}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/><CheckBox IsChecked="{Binding IncludeExecutionHealth}" Margin="0,5,0,0"><TextBlock Text="Include execution-health check" Foreground="{StaticResource Navy}" FontSize="12"/></CheckBox></StackPanel><Button Grid.Column="2" Content="Evaluate rules" Command="{Binding EvaluateInventoryUpgradeRulesCommand}" Margin="0,0,7,0" VerticalAlignment="Center"/><Button Grid.Column="3" Style="{StaticResource Secondary}" Content="Open report" Command="{Binding OpenUpgradeRiskReportCommand}" VerticalAlignment="Center"/></Grid></Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,8" Background="#F1F8FC" BorderBrush="#B8D8EA">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                    <TextBlock Text="6" Foreground="White" Background="{StaticResource Blue}" Width="25" Height="25" TextAlignment="Center" Padding="0,3,0,0" FontWeight="Bold"/>
                    <StackPanel Grid.Column="1" Margin="8,0,12,0">
                        <TextBlock Text="ASK INVENTORY AI" Style="{StaticResource Step}"/>
                        <TextBlock Text="Ask naturally about duplicates, module links, orphan candidates or upgrade impact. AI answers only from the saved JSON evidence." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,7" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding InventoryQuestion, UpdateSourceTrigger=PropertyChanged}" ToolTip="Example: Kitne nodes detect hue aur iska kya meaning hai?"/>
                        <Border Margin="0,6,0,0" Padding="8" Background="#E8F2F8" BorderBrush="#B8D8EA" BorderThickness="1" MaxHeight="135">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock Text="{Binding InventoryAiAnswer}" Foreground="{StaticResource Navy}" FontSize="12" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource Secondary}" Content="Use JSON" Command="{Binding UseExistingInventoryJsonCommand}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Content="Ask AI" Command="{Binding AskInventoryAiCommand}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel></ScrollViewer>
    </Grid>
</Window>
