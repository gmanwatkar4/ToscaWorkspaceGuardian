<Window x:Class="ToscaWorkspaceGuardian.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Tosca Workspace Guardian"
        Height="700"
        Width="900"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="20">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>

            <!-- ==================================================== -->
            <!-- Title -->
            <!-- ==================================================== -->

            <TextBlock
                Grid.Row="0"
                Text="Tosca Workspace Guardian"
                FontSize="34"
                FontWeight="Bold"/>

            <!-- ==================================================== -->
            <!-- Source Version -->
            <!-- ==================================================== -->

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="250"/>

                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    Text="Source Version"/>

                <ComboBox
                    Grid.Column="1"
                    SelectedValue="{Binding SourceVersion}"
                    SelectedIndex="0">

                    <ComboBoxItem Content="2024.2"/>
                    <ComboBoxItem Content="2025.1"/>
                    <ComboBoxItem Content="2026.1"/>

                </ComboBox>

            </Grid>

            <!-- ==================================================== -->
            <!-- Target Version -->
            <!-- ==================================================== -->

            <Grid Grid.Row="4">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="250"/>

                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    Text="Target Version"/>

                <ComboBox
                    Grid.Column="1"
                    SelectedValue="{Binding TargetVersion}"
                    SelectedIndex="2">

                    <ComboBoxItem Content="2025.1"/>
                    <ComboBoxItem Content="2026.1"/>

                </ComboBox>

            </Grid>

            <!-- ==================================================== -->
            <!-- Workspace -->
            <!-- ==================================================== -->

            <Grid Grid.Row="6">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>

                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    Text="Workspace (.tws)"/>

                <TextBox
                    Grid.Column="1"
                    Margin="5,0"
                    Text="{Binding WorkspacePath}"/>

                <Button
                    Grid.Column="2"
                    Margin="10,0,0,0"
                    Height="30"
                    Content="Browse"
                    Command="{Binding BrowseWorkspaceCommand}"/>

            </Grid>

            <!-- ==================================================== -->
            <!-- Repository -->
            <!-- ==================================================== -->

            <Grid Grid.Row="8">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    Text="Repository Type"/>

                <TextBox
                    Grid.Column="1"
                    IsReadOnly="True"
                    Text="{Binding RepositoryType}"/>

            </Grid>

            <!-- ==================================================== -->
            <!-- Project ID -->
            <!-- ==================================================== -->

            <Grid Grid.Row="10">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    Text="Project ID"/>

                <TextBox
                    Grid.Column="1"
                    IsReadOnly="True"
                    Text="{Binding ProjectId}"/>

            </Grid>

            <!-- ==================================================== -->
            <!-- SQL Authentication -->
            <!-- ==================================================== -->

            <StackPanel
                Grid.Row="12"
                Visibility="{Binding ShowSqlAuthentication,
                                     Converter={StaticResource BooleanToVisibilityConverter}}">

                <Grid Margin="0,0,0,10">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="300"/>

                    </Grid.ColumnDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        Text="Username"/>

                    <TextBox
                        Grid.Column="1"
                        Text="{Binding Username}"/>

                </Grid>

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="300"/>

                    </Grid.ColumnDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        Text="Password"/>

                    <PasswordBox
                        Grid.Column="1"/>

                </Grid>

            </StackPanel>

            <!-- ==================================================== -->
            <!-- TSR Authentication -->
            <!-- ==================================================== -->

            <StackPanel
                Grid.Row="12"
                Visibility="{Binding ShowTsrAuthentication,
                                     Converter={StaticResource BooleanToVisibilityConverter}}">

                <Grid Margin="0,0,0,10">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="300"/>

                    </Grid.ColumnDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        Text="Client ID"/>

                    <TextBox
                        Grid.Column="1"
                        Text="{Binding ClientId}"/>

                </Grid>

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="300"/>

                    </Grid.ColumnDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        Text="Client Secret"/>

                    <PasswordBox
                        Grid.Column="1"/>

                </Grid>

            </StackPanel>

            <!-- ==================================================== -->
            <!-- Output Folder -->
            <!-- ==================================================== -->

            <Grid Grid.Row="14">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>

                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    Text="Output Folder"/>

                <TextBox
                    Grid.Column="1"
                    Margin="5,0"
                    Text="{Binding OutputFolder}"/>

                <Button
                    Grid.Column="2"
                    Margin="10,0,0,0"
                    Height="30"
                    Content="Browse"
                    Command="{Binding BrowseOutputFolderCommand}"/>

            </Grid>

            <!-- ==================================================== -->
            <!-- Analyze -->
            <!-- ==================================================== -->

            <Button
                Grid.Row="16"
                Height="40"
                Width="220"
                HorizontalAlignment="Center"
                FontWeight="Bold"
                FontSize="15"
                Content="Analyze Workspace"
                Command="{Binding AnalyzeCommand}"/>

            <!-- ==================================================== -->
            <!-- Status -->
            <!-- ==================================================== -->

            <GroupBox
                Grid.Row="18"
                Header="Status">

                <TextBox
                    Height="170"
                    TextWrapping="Wrap"
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    VerticalScrollBarVisibility="Auto"
                    Text="{Binding StatusMessage}"/>

            </GroupBox>

        </Grid>

    </ScrollViewer>

</Window>